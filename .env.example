# Railway → Postgres service → Variables → DATABASE_PUBLIC_URL
# Not DATABASE_URL: that hostname only resolves inside Railway.
DATABASE_URL=postgresql://postgres:password@turntable.proxy.rlwy.net:12345/railway

# openssl rand -base64 32
AUTH_SECRET=

# Your Vercel production URL, or http://localhost:3000 locally
AUTH_URL=http://localhost:3000

EVENTS_INBOX=events@central.edu
RESEND_API_KEY=
